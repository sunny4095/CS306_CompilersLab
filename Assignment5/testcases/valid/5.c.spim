	lw $v0, 0($fp)
	lw $t1, 0($fp)
	add t0, v0, t1
	sw $t0, 0($fp)
	lw $v0, 0($fp)
	li $t1, 2
	add t0, v0, t1
	sw $t0, 0($fp)
	j L2
L2:
	l.d $v1, 0($fp)
	j epilogue_
	lw $v0, 0($fp)
	sw $v0, 0($fp)
	j L3
L3:
	l.d $v1, 0($fp)
	j epilogue_
	li $v0, 3
	sw $v0, 0($fp)
	lw $v0, 0($fp)
	sw $v0, 0($sp)
	sub $sp, $sp, 4
	lw $v0, 0($fp)
	sw $v0, 0($sp)
	sub $sp, $sp, 4
	jal f1_
	add $sp, $sp, 4
	add $sp, $sp, 4
	move $v0, v1
	sw $v0, 0($fp)
	li $v0, 1
	lw $a0, 0($fp)
	syscall
